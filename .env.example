# Maheshwari Jewellers — environment variable template
# Copy values into backend/.env and frontend/.env as needed.
# NEVER commit real secrets.

# -----------------------------------------------------------------------------
# Frontend (frontend/.env) — baked in at build time by Vite
# -----------------------------------------------------------------------------
# Backend origin only (no trailing slash, no /api suffix).
# Local:
VITE_API_URL=http://localhost:8000
# Production example (set in Render Static Site env, then rebuild):
# VITE_API_URL=https://your-api.onrender.com

# -----------------------------------------------------------------------------
# Backend (backend/.env)
# -----------------------------------------------------------------------------
# MongoDB Atlas connection string and database name
MONGO_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=maheshwari_jewellers

# Comma-separated frontend origin(s) allowed by CORS (no wildcard when using cookies)
FRONTEND_URL=http://localhost:5173
# Optional extra origins (merged with FRONTEND_URL):
# CORS_ORIGINS=http://localhost:3000

# Initial admin (used only when no admin document exists — idempotent)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Session cookie flags
# Local (Vite → API on different ports): leave defaults, or set COOKIE_SECURE=false
# Production cross-origin (static site + API on different hosts):
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Optional: absolute public URL of this API (makes local /api/media/... URLs absolute)
# PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Object storage (S3-compatible: Cloudflare R2, AWS S3, MinIO, …)
# When S3_BUCKET_NAME + keys are set, uploads go to object storage.
# When unset, images are stored under backend/uploads/ (local dev only).
# -----------------------------------------------------------------------------
# S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=maheshwari-jewellers
# S3_REGION=auto
# S3_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
