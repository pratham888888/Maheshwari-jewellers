# Maheshwari Jewellers — environment variable template
# Copy into backend/.env and frontend/.env as needed.
# NEVER commit real secrets.

# -----------------------------------------------------------------------------
# Frontend (frontend/.env) — baked in at build time by Vite
# -----------------------------------------------------------------------------
# Backend origin only (no trailing slash, no /api suffix).
# Local (optional): leave empty to use Vite /api proxy, OR set:
VITE_API_URL=http://localhost:8000
# Production (set on Render Static Site before build):
# VITE_API_URL=https://your-api.onrender.com

# -----------------------------------------------------------------------------
# Backend (backend/.env)
# -----------------------------------------------------------------------------
MONGO_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=maheshwari_jewellers

# Comma-separated frontend origin(s) for CORS (never use * with cookies)
FRONTEND_URL=http://localhost:5173
# Optional extra origins merged with FRONTEND_URL:
CORS_ORIGINS=http://127.0.0.1:5173

# Initial admin — used only when no admin document exists (idempotent)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Session cookie flags
# Local:
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Production (cross-origin frontend + API):
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# Optional: absolute public URL of this API (makes local /api/media/... URLs absolute)
# PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Object storage (S3-compatible: Cloudflare R2, AWS S3, MinIO, …)
# ALL of the following must be set for production uploads.
# If any are missing, images fall back to backend/uploads/ (local development only).
# -----------------------------------------------------------------------------
# S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=maheshwari-jewellers
# S3_REGION=auto
# S3_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
